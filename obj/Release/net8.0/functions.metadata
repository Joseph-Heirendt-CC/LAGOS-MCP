        "toolName": "lookup_door_for_ui_selection",
        "description": "Search for active Doors (retail accounts) and return results formatted for a UI choice picker. Supply at least one of: baId, name, city, or state. Returns { \u0022choices\u0022: [{\u0022title\u0022: \u0022\u003Ccompany name\u003E\u0022, \u0022value\u0022: \u0022\u003Cid\u003E\u0022}] } \u2014 suitable for Copilot Studio adaptive card choice sets. Use the value (id) as doorId in create_store_visit and other door tools.",
        "properties": {}
      },
      {
        "name": "name",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "name",
        "description": "Partial company name match",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "baId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "baId",
        "description": "Brand Ambassador employee internal ID (numeric NetSuite ID)",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "city",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "city",
        "description": "Partial city match",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "state",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "state",
        "description": "Exact two-letter state abbreviation",
        "isRequired": false,
        "properties": {}
      }
    ]
  },
  {
    "name": "LookupBrandAmbassador",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "DoorTools.LookupBrandAmbassador",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "lookup_brand_ambassador",
        "description": "Resolve a Brand Ambassador (NetSuite employee) by name or email to obtain their internal ID. Supply at least one of: name (partial first or last name match) or email (partial email match). Filters to active employees only. Returns up to 25 matches with: id, entityId, firstName, lastName, email. Use the returned id as brandAmbassadorId in create_store_visit.",
        "properties": {}
      },
      {
        "name": "name",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "name",
        "description": "Partial first or last name match",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "email",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "email",
        "description": "Partial email address match",
        "isRequired": false,
        "properties": {}
      }
    ]
  },
  {
    "name": "GetDoorContacts",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "DoorTools.GetDoorContacts",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "get_door_contacts",
        "description": "Returns all active Contacts linked to a Door (retail account). Surfaces each contact\u0027s name, email, phone, title, and role (e.g. Sales Associate, Store Manager, Department Manager). Requires doorId \u2014 the Customer internal ID returned by lookup_door.",
        "properties": {}
      },
      {
        "name": "doorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "doorId",
        "description": "Customer internal ID from lookup_door",
        "isRequired": true,
        "properties": {}
      }
    ]
  },
  {
    "name": "GetOpenTasksForDoor",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "DoorTools.GetOpenTasksForDoor",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "get_open_tasks_for_door",
        "description": "Returns open escalation Tasks associated with a Door. Filters to not-started and in-progress tasks only (excludes COMPLETE). Returns task id, title, status, priority, start date, due date, assigned employee, and message body. Requires doorId from lookup_door. Optional limit (default 25, max 100).",
        "properties": {}
      },
      {
        "name": "doorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "doorId",
        "description": "Customer internal ID from lookup_door",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "limit",
        "direction": "In",
        "type": "mcpToolProperty",
        "propertyName": "limit",
        "description": "Max records to return (default 25, max 100)",
        "isRequired": false,
        "properties": {}
      }
    ]
  },
  {
    "name": "GetEventAndTrainingHistory",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "DoorTools.GetEventAndTrainingHistory",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "get_event_and_training_history",
        "description": "Retrieves Event (Project/Job) records and Training Recap records associated with a Door to support pre-visit preparation. Returns two separate arrays: events and trainingRecaps. Optional filters: startDate and endDate (MM/DD/YYYY format). Optional limit (default 20 each, max 50). Requires doorId from lookup_door.",
        "properties": {}
      },
      {
        "name": "doorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "doorId",
        "description": "Customer internal ID from lookup_door",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "startDate",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "startDate",
        "description": "Start date filter in MM/DD/YYYY format",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "endDate",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "endDate",
        "description": "End date filter in MM/DD/YYYY format",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "limit",
        "direction": "In",
        "type": "mcpToolProperty",
        "propertyName": "limit",
        "description": "Max records per type (default 20, max 50)",
        "isRequired": false,
        "properties": {}
      }
    ]
  },
  {
    "name": "CreateStoreVisit",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "StoreVisitTools.CreateStoreVisit",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "create_store_visit",
        "description": "Creates a new Store Visit record in NetSuite as a skeleton for the visit.  Call this at the start of a store visit before capturing checklist data. Required parameters: doorId (Customer internal ID from lookup_door), brandAmbassadorId (employee internal ID of the visiting BA), visitDate (any recognizable date format, e.g. \u0027June 2nd 2026\u0027, \u00276/2/26\u0027, \u00272026-06-02\u0027), name (title of this visit record \u2014 NOT the store or company name; the store is identified by doorId; e.g. \u0027Smith - Nordstrom Visit 6/11/2026\u0027). Returns the new record\u0027s id \u2014 pass this as recordId to update_store_visit.",
        "properties": {}
      },
      {
        "name": "doorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "doorId",
        "description": "Customer internal ID from lookup_door",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "brandAmbassadorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "brandAmbassadorId",
        "description": "Employee internal ID of the visiting BA",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "visitDate",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "visitDate",
        "description": "Visit date in any recognizable format (e.g. \u0027June 2nd 2026\u0027, \u00276/2/26\u0027, \u00272026-06-02\u0027)",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "name",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "name",
        "description": "Title of this visit record \u2014 NOT the store or company name (e.g. \u0027Smith - Nordstrom Visit 6/11/2026\u0027). The store is identified by doorId.",
        "isRequired": true,
        "properties": {}
      }
    ]
  },
  {
    "name": "UpdateStoreVisit",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "StoreVisitTools.UpdateStoreVisit",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "update_store_visit",
        "description": "Updates an existing Store Visit record with checklist responses, issue flags, and summary fields. Pass recordId (from create_store_visit or get_recent_store_visits) and a fields JSON object containing only the fields to update. Boolean values must be \u0027T\u0027 (true) or \u0027F\u0027 (false). \n\nAUDIT BOOLEANS (\u0027T\u0027/\u0027F\u0027):\ncustrecord_cca_sv_backstock_inv_audited \u2014 Backstock inventory audit completed\ncustrecord_cca_sv_price_audited \u2014 Price audit completed\ncustrecord_cca_sv_pad_product_audit \u2014 Pad product audit completed\ncustrecord_cca_sv_pres_elem_audit \u2014 Presentation elements audit completed\ncustrecord_cca_sv_fixture_layout_audit \u2014 Fixture layout audit completed\ncustrecord_cca_sv_market_material_audit \u2014 Marketing material audit completed\ncustrecord_cca_sv_caseline_flow_reviewed \u2014 Caseline flow reviewed\ncustrecord_cca_sv_tarnishing_check \u2014 Tarnishing check completed\ncustrecord_cca_sv_vitrine_audited \u2014 Vitrine audited\ncustrecord_cca_sv_sales_floor_rep_verif \u2014 Sales floor rep verified\n\nISSUE FLAGS (\u0027T\u0027/\u0027F\u0027):\ncustrecord_cca_sv_backstock_inv_issue \u2014 Backstock inventory issue identified\ncustrecord_cca_sv_price_issue_id \u2014 Price issue identified\ncustrecord_cca_sv_pad_prod_issue \u2014 Pad product issue identified\ncustrecord_cca_sv_pres_elem_issue \u2014 Presentation elements issue identified\ncustrecord_cca_sv_fixture_layout_issue \u2014 Fixture layout issue identified\ncustrecord_cca_sv_mark_material_issue \u2014 Marketing material issue identified\ncustrecord_cca_sv_caseline_flow_issue \u2014 Caseline flow issue identified\ncustrecord_cca_sv_tarnish_issue \u2014 Tarnishing issue identified\ncustrecord_cca_sv_vitrine_issue_identi \u2014 Vitrine issue identified\ncustrecord_cca_sv_dsa_issue_idenified \u2014 DSA issue identified\ncustrecord_cca_sv_mark_opp_identified \u2014 Marketing opportunity identified\ncustrecord_cca_sv_qual_iss_id \u2014 Quality issue identified\ncustrecord_cca_sv_prod_tags_issue \u2014 Product tags issue identified\ncustrecord_cca_sv_prod_tag_tucked \u2014 Product tag tucked issue\ncustrecord_cca_sv_training_needs_id \u2014 Training needs identified\ncustrecord_cca_sv_space_location_moved \u2014 Space/location moved issue\ncustrecord_cca_sv_incentive_running \u2014 Incentive currently running\ncustrecord_cca_sv_store_aware_incentive \u2014 Store aware of incentive\ncustrecord_cca_sv_competitor_incentives \u2014 Competitor incentives present\n\nTEXT / NUMERIC FIELDS:\ncustrecord_cca_sv_immediate_actions (string) \u2014 Immediate actions taken during visit\ncustrecord_cca_sv_next_visit_focus (string) \u2014 Focus areas for next visit\ncustrecord_cca_sv_caseline_space (number) \u2014 Caseline space count\ncustrecord_cca_sv_gold_pads (number) \u2014 Gold pad count\ncustrecord_cca_sv_numb_pads_mens (number) \u2014 Number of men\u0027s pads\ncustrecord_cca_sv_numb_pads_women (number) \u2014 Number of women\u0027s pads\ncustrecord_cca_sv_total_gold_pads (number) \u2014 Total gold pads\ncustrecord_cca_sv_total_pads (number) \u2014 Total pads\n\nExample: { \u0022custrecord_cca_sv_backstock_inv_audited\u0022: \u0022T\u0022, \u0022custrecord_cca_sv_backstock_inv_issue\u0022: \u0022F\u0022, \u0022custrecord_cca_sv_immediate_actions\u0022: \u0022Replenish pad tray\u0022 }",
        "properties": {}
      },
      {
        "name": "recordId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "recordId",
        "description": "Internal ID of the store visit record",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "fieldsJson",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "fields",
        "description": "Key-value pairs of fields to update",
        "isRequired": true,
        "properties": {}
      }
    ]
  },
  {
    "name": "GetRecentStoreVisits",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "StoreVisitTools.GetRecentStoreVisits",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "get_recent_store_visits",
        "description": "Retrieves the most recent Store Visit records for a Door, used to generate the Pre-Visit Summary. Returns visit date, type, brand ambassador, immediate actions, next visit focus, total pads, and total gold pads per visit. Use the returned id as recordId when calling update_store_visit on an existing record. Requires doorId from lookup_door. Optional limit (default 5, max 50).",
        "properties": {}
      },
      {
        "name": "doorId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "doorId",
        "description": "Customer internal ID from lookup_door",
        "isRequired": true,
        "properties": {}
      },
      {
        "name": "limit",
        "direction": "In",
        "type": "mcpToolProperty",
        "propertyName": "limit",
        "description": "Max records to return (default 5, max 50)",
        "isRequired": false,
        "properties": {}
      }
    ]
  }
]