[
  {
    "name": "LookupDoor",
    "scriptFile": "NSRest_MCP_V1.dll",
    "entryPoint": "DoorTools.LookupDoor",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "toolCall",
        "direction": "In",
        "type": "mcpToolTrigger",
        "toolName": "lookup_door",
        "description": "Resolve a Door (retail account / company-type Customer) in NetSuite by one or more criteria. Supply at least one of: baId (Brand Ambassador employee internal ID, numeric), name (partial company name match), city (partial city match), or state (exact two-letter state abbreviation). Filters to active Doors only (custentity_cca_door = T). Returns up to 100 matches with: id, entityId, companyName, brandAmbassador, wbm, planner, subsidiary. Use the returned id as doorId in all other door and store visit tools.",
        "properties": {}
      },
      {
        "name": "name",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "name",
        "description": "Partial company name match",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "baId",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "baId",
        "description": "Brand Ambassador employee internal ID (numeric NetSuite ID)",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "city",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "city",
        "description": "Partial city match",
        "isRequired": false,
        "properties": {}
      },
      {
        "name": "state",
        "direction": "In",
        "type": "mcpToolProperty",
        "dataType": "String",
        "propertyName": "state",
        "description": "Exact two-letter state abbreviation",
        "isRequired": false,
        "properties": {}
      }
    ]
  },
  {
    "name": "LookupDoorForUiSelection",
    "scriptFile": "NSRest_MCP_V1.dll",
